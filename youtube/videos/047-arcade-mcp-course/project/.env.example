# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Arcade — https://api.arcade.dev  (Dashboard → API Keys)
ARCADE_API_KEY=

# --- LLM provider (modules 3, 4, 5) ---
# Which LLM the agents use: "openai" (default) or "anthropic". Swap this ONE line
# to change providers — the Arcade tools stay identical (model-agnostic). Good
# on-camera beat, and lets you test on OpenAI credits, film the final on Claude.
LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com  (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Anthropic (Claude) — https://console.anthropic.com  (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# The user identity Arcade authorizes tools against (use your email).
# Arcade stores + refreshes the per-user OAuth tokens; they never live here.
ARCADE_USER_ID=you@example.com

# ClickUp (used by the scheduled Morning Planner, module 5).
# NOTE: if you connect ClickUp THROUGH Arcade's ClickUp tool, Arcade holds this
# auth and you do NOT put a ClickUp token here. Kept here only if a module calls
# ClickUp's API directly. Confirm during build.
# CLICKUP_API_TOKEN=

# Your Arcade Gateway URL (module 1) — the MCP endpoint Claude Code connects to.
# ARCADE_GATEWAY_URL=
